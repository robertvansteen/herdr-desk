#!/usr/bin/env bash
# Runs the board in the current terminal. The root is this script's real path, so
# each checkout (or a symlink to it on PATH) runs its own code. Textual draws the UI
# on stderr, so stderr must stay on the terminal; only the exit is logged, and a
# failure pauses so its message is visible.
root=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
[[ -x $root/.venv/bin/python ]] || bash "$root/install.sh" || exit 1
log=${XDG_STATE_HOME:-$HOME/.local/state}/desk/ui.log; mkdir -p "$(dirname "$log")"
export TERM=${TERM:-xterm-256color}
"$root/.venv/bin/python" "$root/desk.py"
rc=$?; echo "$(date +%FT%T) desk.py exited rc=$rc" >>"$log"
[[ $rc -ne 0 ]] && { echo "desk exited with $rc"; sleep 8; }
exit $rc
